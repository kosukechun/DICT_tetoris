option_settings:
  aws:elasticbeanstalk:application:environment:
    PORT: '8080'
    NODE_ENV: production
    TRUST_PROXY: '2'
  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: nginx
  aws:elasticbeanstalk:cloudwatch:logs:
    StreamLogs: true
    DeleteOnTerminate: false
    RetentionInDays: 7
  aws:autoscaling:launchconfiguration:
    DisableIMDSv1: true
